{
  "version": 2,
  "builds": [
    {
      "src": "hos_backend/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "hos_backend/wsgi.py"
    }
  ]
}